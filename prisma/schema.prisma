datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Cargo {
  ADMIN
  FUNCIONARIO
}

enum StatusAgendamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String   @unique
  senha     String   // Hash com bcryptjs
  cargo     Cargo    @default(FUNCIONARIO)
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agendamentos Agendamento[] // Agendamentos gerenciados/criados por este usuário

  @@map("usuarios")
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  email     String?
  cpf       String?
  telefone  String
  observacoes String?
  codigo    Int      @unique @default(autoincrement())
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agendamentos Agendamento[]

  @@map("clientes")
}

model Colaborador {
  id        String   @id @default(cuid())
  codigo    Int      @unique @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("colaboradores")
}

model Servico {
  id          String   @id @default(cuid())
  nome        String
  preco       Decimal  @db.Decimal(10, 2)
  duracaoMin  Int      // Duração em minutos
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agendamentos Agendamento[]

  @@map("servicos")
}

model Agendamento {
  id        String            @id @default(cuid())
  data      DateTime          // Data e hora agendada
  status    StatusAgendamento @default(AGENDADO)
  observacoes String?
  
  // Relações
  clienteId  String @map("cliente_id")
  cliente    Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  
  servicoId  String @map("servico_id")
  servico    Servico  @relation(fields: [servicoId], references: [id])
  
  usuarioId   String?  @map("usuario_id") // Quem realizou/agendou
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id])

  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([data])
  @@map("agendamentos")
}
