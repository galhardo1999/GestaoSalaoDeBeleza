datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Cargo {
  ADMIN
  FUNCIONARIO
  SUPER_ADMIN
}

enum StatusAgendamento {
  AGENDADO
  PENDENTE
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

enum ComissaoTipo {
  PORCENTAGEM
  VALOR_FIXO
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String   @unique
  senha     String   // Hash com bcryptjs
  cargo     Cargo    @default(FUNCIONARIO)
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agendamentos Agendamento[] // Agendamentos gerenciados/criados por este usuário

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("usuarios")
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  email     String?
  cpf       String?  @unique
  dataNascimento DateTime? @map("data_nascimento")
  telefone  String
  observacoes String?
  codigo    Int      @unique @default(autoincrement())
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agendamentos Agendamento[]
  
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("clientes")
}

model Colaborador {
  id        String   @id @default(cuid())
  codigo    Int      @default(autoincrement())
  nome      String
  email     String   @unique
  cpf       String?  @unique
  senha     String
  foto      String?
  comissaoTipo  ComissaoTipo @default(PORCENTAGEM)
  comissaoValor Decimal?     @db.Decimal(10, 2)
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agendamentos Agendamento[]
  servicos     Servico[] 

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("colaboradores")
}

model Servico {
  id          String   @id @default(cuid())
  nome        String
  preco       Decimal  @db.Decimal(10, 2)
  duracaoMin  Int      // Duração em minutos
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agendamentos Agendamento[]
  colaboradores Colaborador[] 

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("servicos")
}

model Agendamento {
  id        String            @id @default(cuid())
  data      DateTime          // Data e hora agendada
  status    StatusAgendamento @default(AGENDADO)
  valor     Decimal?          @db.Decimal(10, 2)
  observacoes String?
  
  // Relações
  clienteId  String @map("cliente_id")
  cliente    Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  
  servicoId  String @map("servico_id")
  servico    Servico  @relation(fields: [servicoId], references: [id])
  
  usuarioId   String?  @map("usuario_id") // Quem realizou/agendou
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id])

  colaboradorId String? @map("colaborador_id")
  colaborador Colaborador? @relation(fields: [colaboradorId], references: [id])
  
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([data])
  @@map("agendamentos")
}

model Empresa {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String   @unique
  telefone1 String?
  telefone2 String?
  endereco  String?
  logo      String?
  mensagemWhatsapp String?
  
  // Endereço detalhado
  cep       String?
  numero    String?
  bairro    String?
  cidade    String?
  estado    String? // UF

  googleAvaliacaoUrl String?
  instagramUrl       String?

  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuarios Usuario[]
  clientes Cliente[]
  colaboradores Colaborador[]
  servicos Servico[]
  agendamentos Agendamento[]
  contratos Contrato[]

  @@map("empresas")
}

model Plano {
  id          String   @id @default(cuid())
  nome        String
  descricao   String? // Opcional
  meses       Int      // Duração em meses (ex: 1, 6, 12)
  valor       Decimal  @db.Decimal(10, 2)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  contratos   Contrato[]

  @@map("planos")
}

model Contrato {
  id            String   @id @default(cuid())
  
  inicio        DateTime
  fim           DateTime
  valorAcordado Decimal  @map("valor_acordado") @db.Decimal(10, 2)
  ativo         Boolean  @default(true)
  
  // Relations
  empresaId     String   @map("empresa_id")
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  planoId       String   @map("plano_id")
  plano         Plano    @relation(fields: [planoId], references: [id])

  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@map("contratos")
}
