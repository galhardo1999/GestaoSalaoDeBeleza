generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           String        @id @default(cuid())
  nome         String
  senha        String
  cargo        Cargo         @default(FUNCIONARIO)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  cnpj         String        @unique
  empresaId    String?
  agendamentos Agendamento[]
  empresa      Empresa?      @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("usuarios")
}

model Cliente {
  id             String        @id @default(cuid())
  nome           String
  email          String?
  telefone       String
  observacoes    String?
  criadoEm       DateTime      @default(now()) @map("criado_em")
  atualizadoEm   DateTime      @updatedAt @map("atualizado_em")
  codigo         Int           @unique @default(autoincrement())
  cpf            String?       @unique
  empresaId      String
  dataNascimento DateTime?     @map("data_nascimento")
  agendamentos   Agendamento[]
  empresa        Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("clientes")
}

model Colaborador {
  id                String              @id @default(cuid())
  codigo            Int                 @default(autoincrement())
  nome              String
  email             String              @unique
  senha             String
  criadoEm          DateTime            @default(now()) @map("criado_em")
  atualizadoEm      DateTime            @updatedAt @map("atualizado_em")
  foto              String?
  empresaId         String
  cpf               String?             @unique
  comissaoTipo      ComissaoTipo        @default(PORCENTAGEM)
  comissaoValor     Decimal?            @db.Decimal(10, 2)
  agendamento_itens agendamento_itens[]
  agendamentos      Agendamento[]
  empresa           Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  servicos          Servico[]           @relation("ColaboradorToServico")
  horarios          HorarioColaborador[]

  @@map("colaboradores")
}

model HorarioColaborador {
  id             String      @id @default(cuid())
  diaSemana      Int
  aberto         Boolean     @default(true)
  horaAbertura   String?
  horaFechamento String?
  colaboradorId  String      @map("colaborador_id")
  empresaId      String      @map("empresa_id")
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, diaSemana])
  @@map("horarios_colaborador")
}

model Servico {
  id                String              @id @default(cuid())
  nome              String
  preco             Decimal             @db.Decimal(10, 2)
  duracaoMin        Int
  ativo             Boolean             @default(true)
  criadoEm          DateTime            @default(now()) @map("criado_em")
  atualizadoEm      DateTime            @updatedAt @map("atualizado_em")
  empresaId         String
  agendamento_itens agendamento_itens[]
  empresa           Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  colaboradores     Colaborador[]       @relation("ColaboradorToServico")

  @@map("servicos")
}

model Agendamento {
  id                String              @id @default(cuid())
  data              DateTime
  status            StatusAgendamento   @default(AGENDADO)
  observacoes       String?
  clienteId         String              @map("cliente_id")
  usuarioId         String?             @map("usuario_id")
  criadoEm          DateTime            @default(now()) @map("criado_em")
  atualizadoEm      DateTime            @updatedAt @map("atualizado_em")
  colaboradorId     String?             @map("colaborador_id")
  empresaId         String
  valor             Decimal?            @db.Decimal(10, 2)
  agendamento_itens agendamento_itens[]
  cliente           Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  colaborador       Colaborador?        @relation(fields: [colaboradorId], references: [id])
  empresa           Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario           Usuario?            @relation(fields: [usuarioId], references: [id])

  @@index([data])
  @@map("agendamentos")
}

model Empresa {
  id                    String                 @id @default(cuid())
  nome                  String
  cnpj                  String                 @unique
  telefone1             String?
  telefone2             String?
  endereco              String?
  criadoEm              DateTime               @default(now()) @map("criado_em")
  atualizadoEm          DateTime               @updatedAt @map("atualizado_em")
  logo                  String?
  mensagemWhatsapp      String?
  bairro                String?
  cep                   String?
  cidade                String?
  estado                String?
  numero                String?
  googleAvaliacaoUrl    String?
  instagramUrl          String?
  banner                String?
  slug                  String                 @unique
  facebookUrl           String?
  formasPagamento       String?
  comodidades           String?
  latitude              Float?
  longitude             Float?
  agendamentos          Agendamento[]
  clientes              Cliente[]
  colaboradores         Colaborador[]
  contratos             Contrato[]
  horariosFuncionamento HorarioFuncionamento[]
  horariosColaborador   HorarioColaborador[]
  servicos              Servico[]
  usuarios              Usuario[]

  @@map("empresas")
}

model HorarioFuncionamento {
  id             String  @id @default(cuid())
  diaSemana      Int
  aberto         Boolean @default(true)
  horaAbertura   String?
  horaFechamento String?
  empresaId      String  @map("empresa_id")
  empresa        Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, diaSemana])
  @@map("horarios_funcionamento")
}

model Plano {
  id           String     @id @default(cuid())
  nome         String
  descricao    String?
  meses        Int
  valor        Decimal    @db.Decimal(10, 2)
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")
  contratos    Contrato[]

  @@map("planos")
}

model Contrato {
  id            String   @id @default(cuid())
  inicio        DateTime
  fim           DateTime
  valorAcordado Decimal  @map("valor_acordado") @db.Decimal(10, 2)
  ativo         Boolean  @default(true)
  empresaId     String   @map("empresa_id")
  planoId       String   @map("plano_id")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  plano         Plano    @relation(fields: [planoId], references: [id])

  @@map("contratos")
}

model agendamento_itens {
  id             String      @id
  preco          Decimal     @db.Decimal(10, 2)
  duracao        Int
  servico_id     String
  colaborador_id String
  agendamento_id String
  criado_em      DateTime    @default(now())
  atualizado_em  DateTime
  agendamentos   Agendamento @relation(fields: [agendamento_id], references: [id], onDelete: Cascade)
  colaboradores  Colaborador @relation(fields: [colaborador_id], references: [id])
  servicos       Servico     @relation(fields: [servico_id], references: [id])
}

enum Cargo {
  ADMIN
  FUNCIONARIO
  SUPER_ADMIN
}

enum StatusAgendamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
  PENDENTE
}

enum ComissaoTipo {
  PORCENTAGEM
  VALOR_FIXO
}
